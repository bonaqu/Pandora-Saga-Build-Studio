{
  "name": "pandora-saga-build-studio",
  "version": "0.105.0",
  "private": true,
  "description": "Self-hosted Pandora Saga build planner, encyclopedia, and D1 catalog tools",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "assets:check": "node scripts/mirror-os-icons.mjs --dry-run",
    "assets:mirror": "node scripts/mirror-os-icons.mjs",
    "assets:audit": "node scripts/audit-os-icons.mjs",
    "assets:audit:strict": "node scripts/audit-os-icons.mjs --strict",
    "release:check": "node scripts/release-version.mjs --check",
    "release:bump": "node scripts/release-version.mjs",
    "connection:check": "node scripts/check-live-connections.mjs",
    "connection:check:full": "node scripts/check-live-connections.mjs --full"
  },
  "pandoraRelease": "2026.10.31.105"
}
